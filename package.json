{
  "name": "covora-outreach-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "setup:local": "node scripts/local-portal.mjs setup",
    "dev:local": "node scripts/local-portal.mjs dev",
    "dev": "next dev --hostname 127.0.0.1 --port 3011",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "NODE_OPTIONS=--conditions=react-server tsx --test tests/unit/*.test.ts && npm run test:tooling",
    "test:db": "NODE_OPTIONS=--conditions=react-server tsx --test --test-concurrency=1 tests/db/*.test.ts",
    "test": "npm run test:unit && npm run test:db",
    "gen:types": "node scripts/gen-types.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test:env": "node scripts/write-test-env.mjs",
    "logs:providers": "node scripts/provider-calls.mjs",
    "logs:invitations": "node scripts/invitation-events.mjs",
    "provider:probe": "NODE_OPTIONS=--conditions=react-server tsx scripts/provider-probe.ts",
    "dev:cloud": "node scripts/cloud-development.mjs",
    "db:cloud": "node scripts/cloud-migrations.mjs",
    "seed:cloud": "node scripts/cloud-seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.108.2",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "supabase": "2.119.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.5"
    },
    "@next/eslint-plugin-next": {
      "fast-glob": "file:../../../vendor/next-lint-glob"
    }
  }
}
