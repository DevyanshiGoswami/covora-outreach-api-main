# New independent project only. Runtime rejects the content portal project.
OUTREACH_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy environment credentials. Owners can also save encrypted keys through the admin Integrations tab.
OUTREACH_INSTANTLY_COVORA=
OUTREACH_HEYREACH_COVORA=
# Optional server-only catalog, alongside connections saved through the admin Integrations tab.
# See docs/account-onboarding.md. Each HeyReach workspace belongs to one client.
OUTREACH_ONBOARDING_WORKSPACES=[]
# Independent operational credentials and deliberately closed delivery gates.
CRON_SECRET=
OUTREACH_PORTAL_ORIGIN=https://covora.app
OUTREACH_REPLIES_ENABLED=false
OUTREACH_SYNC_ENABLED=false
ENABLE_OUTREACH_LEAD_ALERT_EMAILS=false
# Portal outreach (New outreach in the Inbox). Closed by default.
OUTREACH_PORTAL_SEND_ENABLED=false
# live (default) or mock. Mock is development-only and never contacts Instantly.
OUTREACH_INSTANTLY_MODE=live
# Live mode sends only between these exact addresses (comma separated). Empty = no live sends.
OUTREACH_PORTAL_ALLOWED_SENDERS=
OUTREACH_PORTAL_ALLOWED_RECIPIENTS=
# reply_received webhook secret, at least 32 random characters.
OUTREACH_INSTANTLY_WEBHOOK_SECRET=
# Development seed only: repeat this development project's ref to allow npm run dev:seed.
OUTREACH_DEV_SEED_PROJECT_REF=
# Optional: real Instantly workspace ID for live-mode development testing.
OUTREACH_DEV_INSTANTLY_WORKSPACE_ID=
